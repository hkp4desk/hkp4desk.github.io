---
import Layout from "../components/Layout.astro";
import SupportBox from "../components/SupportBox.astro";
import { render } from "astro:content";
import { fmtDate, localize, otherLocale, site, ui, PS, type Locale } from "../lib/ui";
import { getArticles, type Article } from "../lib/articles";

interface Props {
  locale: Locale;
  article: Article;
}

const { locale, article } = Astro.props;
const { entry } = article;
const d = entry.data;
const t = (k: keyof (typeof ui)["zh"]) => ui[locale][k];
const { Content } = await render(entry);

// 找另一语言的译文
const other = otherLocale(locale);
const others = await getArticles(other);
const twin = others.find((a) => a.slug === article.slug);
const twinPath = twin
  ? (twin.locale === "en" ? `/en/articles/${twin.slug}/` : `/articles/${twin.slug}/`)
  : null;
---

<Layout
  locale={locale}
  title={d.title}
  description={d.description}
  altHref={twinPath}
  nav="articles"
  image={d.image ? site.url + d.image : undefined}
  autoLang={!!twinPath}
>
  <article class="article-wrap">
    <header class="article-head">
      <div class="meta">
        <a href={localize(locale, "/articles/")}>{t("back")}</a>
      </div>
      <h1>{d.title}</h1>
      <div class="meta">
        <time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate, locale)}</time>
        <span>{site.author[locale]}</span>
        {d.p.map((key) => (
          <a class="p-tag" href={localize(locale, `/p/${key}/`)}>{PS[key][locale]}{locale === "zh" ? ` ${PS[key].en}` : ""}</a>
        ))}
      </div>
      {twinPath ? (
        <p class="lang-note"><a href={twinPath} onclick={`document.cookie='hkp4_lang=${locale === "zh" ? "en" : "zh"};path=/;max-age=31536000;SameSite=Lax'`}>{t("also_lang")}</a></p>
      ) : (
        <p class="lang-note">{locale === "zh" ? ui.zh.no_lang : ui.en.no_lang}</p>
      )}
    </header>

    {d.image && (
      <figure class="article-illo">
        <img src={d.image} alt={d.title} width="1672" height="941" loading="eager" />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <SupportBox locale={locale} />
  </article>
</Layout>
